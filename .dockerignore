# Keep the build context small: only pyproject.toml, README.md, app/ and
# quan_transcribe/ are copied into the image, so anything else is dead weight in
# the build cache.

.git
.gitignore
.gitlab-ci.yml
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache

# Local model caches must never be baked into an image. The one exception is
# the vendored punctuator: the Dockerfiles fetch it into /opt/models at build
# time so the image needs no network at runtime.
cache
models
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Fixtures and scratch audio. The sample clips under samples/ are the one
# exception: the image ships them so the playground's demo chips work offline.
tests/audio
*.wav
*.mp3
*.flac
*.m4a
*.webm
!samples/*.mp3

docker
deploy
scripts
# The punctuator fetch script is the one thing under scripts/ the image needs:
# the Dockerfiles run it to bake the weights into /opt/models.
!scripts/fetch_punctuator.py
tests
# NOTE: README.md must stay in the context: the Dockerfile copies it because
# pyproject.toml declares `readme = "README.md"`, and setuptools reads it when
# building the wheel inside the image.
Dockerfile
.env
.env.*
*.log
.DS_Store

# Copy to .env and fill in. `.env` is git-ignored; this template is not.
#
# Docker Compose reads this file automatically (`docker compose --env-file .env`),
# and `docker run --env-file .env ...` reads it too.

# Required: QUAN-Transcribe's audio encoder is `google/embeddinggemma-2`, which
# is a gated Hugging Face repo. Accept its license on the model page, create a
# read token, and paste it here.
HF_TOKEN=hf_replace_me

# Pin the device instead of letting the model auto-detect (cuda/mps/cpu).
# DEVICE=cpu

# Turn on the bundled 4-gram KenLM beam search (lower WER, CPU-bound).
# USE_LM=true
# BEAM_WIDTH=32

# Scheduler. See the Performance section of README.md.
# MICROBATCH_SECONDS=0.15
# MICROBATCH_MAX_WAIT_MS=20
# MAX_QUEUE=256          # most pieces waiting to decode; full -> HTTP 503
# MAX_INTERACTIVE=64     # most streaming jobs in flight
# SUBBATCH_SECONDS=10    # cap one forward pass (keeps live audio responsive)
# CHUNK_SECONDS=10       # smaller pieces -> shorter worst-case live wait
# CPU_THREADS=4          # set when the container is cgroup-limited

# Require `Authorization: Bearer <key>` on every request.
# API_KEY=sk-replace_me

# Copy to .env and fill in. `.env` is git-ignored; this template is not.
#
# Docker Compose reads this file automatically (`docker compose --env-file .env`),
# and `docker run --env-file .env ...` reads it too.

# Required: QUAN-Transcribe's audio encoder is `google/embeddinggemma-2`, which
# is a gated Hugging Face repo. Accept its license on the model page, create a
# read token, and paste it here.
HF_TOKEN=hf_replace_me

# Which checkpoint to serve. Either supported layout works:
#   qnguyen3/QUAN-Transcribe-1.0   (config.json + units.json + model.safetensors)
#   5CD-AI/VieGem-ASR              (a single viegem_asr.pt)
# MODEL_PATH=5CD-AI/VieGem-ASR
# SERVED_MODEL_NAME=VieGem-ASR   # what clients send as `model`; keep it in sync
                                 # with MODEL_PATH or clients get a 404

# Pin the device instead of letting the model auto-detect (cuda/mps/cpu).
# DEVICE=cpu

# Turn on the bundled 4-gram KenLM beam search (lower WER, CPU-bound).
# USE_LM=true
# BEAM_WIDTH=32

# Scheduler. See the Performance section of README.md.
# MICROBATCH_SECONDS=0.15
# MICROBATCH_MAX_WAIT_MS=20
# MAX_QUEUE=256          # most pieces waiting to decode; full -> HTTP 503
# MAX_INTERACTIVE=64     # most streaming jobs in flight
# SUBBATCH_SECONDS=10    # cap one forward pass (keeps live audio responsive)
# CHUNK_SECONDS=10       # smaller pieces -> shorter worst-case live wait
# CPU_THREADS=4          # set when the container is cgroup-limited

# HTTP admission control. Every buffered upload holds its whole waveform in RAM,
# so this caps how many may be decoded-and-waiting at once; the rest get a fast
# 503 with `Retry-After` instead of an OOM. 0 disables the cap.
# MAX_UPLOAD_MB=200
# MAX_INFLIGHT_REQUESTS=8

# Voice activity detection (Silero). Skips decoding silence and cuts pieces on
# real pauses. Call/voicemail audio is mostly silence, so this is the biggest
# win on long recordings. Requires the 'vad' extra (the image ships it).
# USE_VAD=true
# VAD_TRIM_SILENCE=true  # false = keep silence, only use VAD for cut points
# VAD_SPEECH_PAD_MS=250  # padding around speech; lower clips the first syllable
# VAD_THRESHOLD=0.5
# VAD_MIN_SILENCE_MS=300

# Punctuation and capitalization (vibert-capu ViBERT). The regex fallback can
# only append '.' or '?'; the model predicts '. , : ?' and complex casing per
# word. Requires the 'punctuate' extra (the image ships it).
# USE_PUNCTUATOR=true
# PUNCTUATOR_MODEL=/opt/models/vibert-capu  # baked into the image at build time
# PUNCTUATOR_INT8=false   # use the fp32 graph (459 MB) instead of int8 (116 MB)
# PUNCTUATOR_MAX_WORDS=200

# Require `Authorization: Bearer <key>` on every request.
# API_KEY=sk-replace_me
